<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
        <OutputType>WinExe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <ApplicationIcon Condition="'$(TargetFramework)' == 'net10.0-windows'">icon.ico</ApplicationIcon>

        <RootNamespace>z3nDash</RootNamespace>
        <!-- Публикуемся папкой, а не одним файлом.
             Проверено на отдельном стенде: в single-file у упакованных сборок
             Assembly.Location пуст, а Roslyn без него не строит ссылки —
             ScriptOptions.AddReferences падает с «Can't create a metadata
             reference to an assembly without location», то есть не работает
             ни один csx и ни один OwnCode в xml-шаблоне.
             IncludeAllContentForSelfExtract это чинит, но уводит
             AppContext.BaseDirectory во временный каталог, а по нему ищутся
             wwwroot, Prompts, sdk и туда же пишется appsettings.secrets.json —
             конфигурация терялась бы при каждом обновлении. -->
        <PublishSingleFile>false</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
        <!--   <ApplicationManifest>app.manifest</ApplicationManifest> -->
        <NoWarn>$(NoWarn);8625;8618;8604;8603;8602;8600;8601;8619</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Update="sdk\python\*.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>

    <!-- Windows-only SDK features -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <UseWindowsForms>true</UseWindowsForms>
    </PropertyGroup>

    <!-- WINDOWS compile-time constant — по таргет-фреймворку, не по ОС -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>

    <!-- Cross-platform packages -->
    <ItemGroup>
        <!-- Patchright вместо Microsoft.Playwright — см. пояснение в ZpRuntime.csproj -->
        <PackageReference Include="Patchright"                                Version="1.61.0" />
        <PackageReference Include="Newtonsoft.Json"                           Version="13.0.4" />
        <PackageReference Include="Npgsql"                                    Version="10.0.1" />
        <PackageReference Include="System.Data.Odbc"                          Version="10.0.2" />
        <PackageReference Include="Nethereum.ABI"                             Version="4.29.0.0" />
        <PackageReference Include="Nethereum.HdWallet"                        Version="4.29.0.0" />
        <PackageReference Include="Nethereum.Web3"                            Version="4.29.0.0" />
        <PackageReference Include="Otp.NET"                                   Version="1.4.0" />
        <PackageReference Include="Cronos"                                    Version="0.8.*" />
        <PackageReference Include="Microsoft.Extensions.Configuration"        Version="8.0.*" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json"   Version="8.0.*" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.*" />
        <PackageReference Include="Microsoft.Extensions.Options"              Version="8.0.*" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting"   Version="4.13.0" />
        <PackageReference Include="System.ServiceProcess.ServiceController"   Version="6.0.0" />
        <PackageReference Include="OpenCvSharp4"                              Version="4.9.0.20240103" />
        <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.*" />

    </ItemGroup>

    <!-- Windows-only packages -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <PackageReference Include="Microsoft.Web.WebView2"       Version="1.0.3800.47" />
        <PackageReference Include="OpenCvSharp4.runtime.win"     Version="4.9.0.20240103" />
        <PackageReference Include="System.Management"            Version="10.0.0-rc.2.25502.107" />
    </ItemGroup>

    <ItemGroup>
        <None Update="wwwroot\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="docs-vault\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="templates\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="wwwroot\static\fonts\JetBrainsMonoNerdFont-Regular.ttf">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Remove="media\z3nDash__.mp4" />
        <None Remove="media\z3nDash_done.mp4" />
        <None Remove="media\z3nDashlogo.mp4" />
        <None Remove="media\**" />
  
    </ItemGroup>

    <ItemGroup>
        <None Update="Prompts\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <!-- Секреты нужны при отладке рядом с bin, но в publish им нельзя:
             иначе строка подключения с паролем уедет в портабл-архив. -->
        <None Update="appsettings.secrets.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
        <None Update="icon.ico">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </None>
    </ItemGroup>

    <!-- Драйвер Patchright (.playwright: node.exe и js-пакет) должен лежать на диске
         рядом с exe: Playwright.CreateAsync ищет его там. При PublishSingleFile он
         иначе запекается внутрь exe, publish отдаёт .playwright без node.exe,
         и любой запуск браузера падает с «Driver not found». -->
    <Target Name="PlaywrightDriverOutOfSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                                   Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('.playwright'))"
                                   ExcludeFromSingleFile="true" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Remove="z3nStub\**" />
        <None Remove="installer_output\**" />
        <None Remove="publish-new\**" />
        <None Remove="UnitTests\**" />
        <None Remove="z3nLib\**" />
        <None Remove="z3n7\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Controllers\ZpOrchestratorHandler.cs" />
        <Compile Remove="ZpRuntime\**" />
        <Compile Remove="z3nStub\**" />
        <Compile Remove="installer_output\**" />
        <Compile Remove="publish-new\**" />
        <Compile Remove="UnitTests\**" />
        <Compile Remove="z3n7\**" />
        <Compile Remove="Controllers\Handlers\TrafficHandler.cs" />
        <Compile Remove="Tasks\csx\Chedraui.cs" />
        <Compile Remove="media\**" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="docs-vault\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="ZpRuntime\ZpRuntime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="z3nStub\**" />
        <EmbeddedResource Remove="installer_output\**" />
        <EmbeddedResource Remove="publish-new\**" />
        <EmbeddedResource Remove="UnitTests\**" />
        <EmbeddedResource Remove="z3nLib\**" />
        <EmbeddedResource Remove="z3n7\**" />
        <EmbeddedResource Remove="media\**" />
    </ItemGroup>

</Project>
