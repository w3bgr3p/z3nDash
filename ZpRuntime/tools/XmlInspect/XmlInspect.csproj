<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Диагностика плеера: разбирает XML-шаблон и печатает граф — точку входа,
      порядок веток, переходы, недостижимые узлы и типы веток, которые плеер
      пока не умеет.

      Ничего не исполняет, браузер не поднимает. Нужен, чтобы по новому шаблону
      сразу видеть, чего не хватает, а не выяснять это падениями на середине
      маршрута.

      В солюшен не добавлен намеренно, как и HwidCheck: запускается вручную
      через dotnet run с указанием этого каталога как project.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>XmlInspect</AssemblyName>
        <RootNamespace>DevDeck.Tools.XmlInspect</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\ZpRuntime.csproj" />
    </ItemGroup>

</Project>
