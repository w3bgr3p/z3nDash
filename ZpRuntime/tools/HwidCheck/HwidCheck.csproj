<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Диагностика: сверяет HWID нашего z3nDash.SAFU с HWID эталонного z3n7 Safu8.

      Оба выводят ключ одинаково (PBKDF2-HMAC-SHA256, 100000, 32 байта, соль из
      safu.key), поэтому расшифровка совпадёт только при совпадении HWID. У z3n7
      в отпечаток входит ещё серийник системного диска — этот раннер показывает,
      расходятся ли строки на конкретной машине.

      В солюшен не добавлен намеренно: запускается вручную через dotnet run
      с указанием этого каталога как project.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>HwidCheck</AssemblyName>
        <RootNamespace>z3nDash.Tools.HwidCheck</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\ZpRuntime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.Management" Version="10.0.0-rc.2.25502.107" />
    </ItemGroup>

</Project>
